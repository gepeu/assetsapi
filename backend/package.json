{
  "name": "rwa-data-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "api": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/api/server.ts",
    "update-universe": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/jobs/updateUniverse.ts",
    "update-data": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/jobs/updateData.ts",
    "migrate": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/db/migrate.ts",
    "setup-roles": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/setupRoles.ts",
    "openapi": "node scripts/generateOpenApi.ts",
    "openapi:check": "node scripts/generateOpenApi.ts --check",
    "typecheck": "tsc",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "lint:migrations": "squawk db/migrations/*.sql",
    "test": "node --env-file-if-exists=.env --import ./test/helpers/blockNetwork.ts --test --test-concurrency=4 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/etag": "6.2.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.3",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "json-schema-to-ts": "3.1.1",
    "prettier": "3.9.10",
    "squawk-cli": "2.70.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
