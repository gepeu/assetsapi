# Copy to .env and fill in. The backend won't start until both are set.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgres://rwa:rwa_local@127.0.0.1:54331/rwa

# "claude" answers chat from stored documents; anything else uses the mock agent.
# Locally this uses your own Claude Code login, for your own use only. Before other users or a
# deployment use the chat, set ANTHROPIC_API_KEY: Anthropic doesn't allow offering a Claude
# subscription login to others. Setting the key is the only change needed.
AGENT_BACKEND=mock
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# RWA.xyz API key. Only the data-load scripts need it. They also read the repo-root .env.
RWA_XYZ_API_KEY=

# Where documents are stored: "local" (.local/documents, the default) or "railway".
STORAGE_BACKEND=local

# Railway Storage Bucket, from the bucket's Credentials tab. Only needed when
# STORAGE_BACKEND=railway. On Railway, these can reference the bucket's
# variables, e.g. S3_BUCKET=${{my-bucket.BUCKET}}.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
