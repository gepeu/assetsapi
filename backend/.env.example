# Copy to backend/.env for local use. In production, each service holds only what it needs.

# The connection for this process, with its own role: rwa_api for the API, rwa_job for the jobs.
DATABASE_URL=postgres://rwa_api:local_api@127.0.0.1:54331/rwa_service

# Used by the migrate step, as rwa_owner.
MIGRATION_DATABASE_URL=postgres://rwa_owner:local_owner@127.0.0.1:54331/rwa_service

# Used only by scripts/setupRoles.ts, with its role passwords.
DATABASE_ADMIN_URL=postgres://rwa:rwa_local@127.0.0.1:54331/rwa_service
RWA_OWNER_PASSWORD=local_owner
RWA_JOB_PASSWORD=local_job
RWA_API_PASSWORD=local_api

# Jobs only. Each cron service has its own monitor URL, such as a Healthchecks.io check.
RWA_XYZ_API_KEY=
JOB_MONITOR_URL=

# API only.
PORT=3000
HOST=::
LOG_LEVEL=info

# Tests only: a role that can create databases and roles.
TEST_DATABASE_URL=postgres://rwa:rwa_local@127.0.0.1:54331/postgres

# ---------------------------------------------------------------------------------------------
# Settings. Every one is optional, and the values below are the defaults from src/config.ts.
# A value that isn't a sensible number or address stops the process when it starts.
# ---------------------------------------------------------------------------------------------

# API: database connections held by each replica. Replicas times this, plus 4 for the jobs and the
# migrate step, has to stay under the Postgres connection limit.
DB_POOL_SIZE=5
# API: how long a request waits for a free connection before it's a 503.
DB_POOL_WAIT_MS=2000
# API: how long to wait for a query's answer before dropping its connection. Must stay above
# API_STATEMENT_TIMEOUT_MS.
DB_QUERY_TIMEOUT_MS=7000
# API: requests one IP address may make in one window, counted separately on each replica.
# The window is a minute by default.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# API: the longest a request may take, and how long in-flight requests get after a stop signal.
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=20000
# API: bytes of data responses each replica keeps in memory (64 MB), and how often it asks whether the
# data changed, which is the longest a kept response can be out of date. 0 turns the cache off, or
# asks on every request.
CACHE_MAX_BYTES=67108864
CACHE_VERSION_CHECK_MS=10000
# API: the asset list's page size when a request gives none, the largest it may ask for, and the
# largest offset. These are part of the API contract, so run `npm run openapi` after changing one.
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
MAX_PAGE_OFFSET=2147483647
# API: the longest search text and asset class filter a request may send.
MAX_FILTER_LENGTH=64
# API: the most metrics one request may ask history for, and the most names any other comma-separated
# parameter may list. These are part of the API contract too.
MAX_HISTORY_METRICS=10
MAX_NAMES_PER_PARAMETER=100
# API: the group shown for a measure that has none of its own.
OTHER_GROUP_LABEL=Other
# OpenAPI script: the database connections it holds.
DB_SCRIPT_POOL_SIZE=1
# OpenAPI script: where the contract is written. Empty means backend/openapi.json.
OPENAPI_PATH=

# The longest asset slug, which can't pass the database's own limit of 64, and the longest measure
# name. Both are part of the API contract.
MAX_SLUG_LENGTH=64
MAX_MEASURE_NAME_LENGTH=64

# Jobs and the migrate step: the lock that keeps them from running at once. Every service must use
# the same number. One given a different number would run unprotected, without any error.
JOB_LOCK_ID=7315204
# Migrate step and the jobs' schema check: the migrations folder. Empty means backend/db/migrations.
MIGRATIONS_DIR=

# Every process: how soon keepalive starts probing an idle database connection.
DB_KEEPALIVE_DELAY_MS=30000
# The job lock's connection: the server's own keepalive, so a vanished job frees the lock.
LOCK_KEEPALIVE_IDLE_SECONDS=60
LOCK_KEEPALIVE_INTERVAL_SECONDS=10
LOCK_KEEPALIVE_COUNT=3
# Migrate step: how long it waits for a running job to finish, and how often it checks.
MIGRATE_LOCK_WAIT_MS=600000
MIGRATE_LOCK_POLL_MS=5000
# Roles script: the statement timeout it sets on the rwa_api role.
API_STATEMENT_TIMEOUT_MS=5000

# Jobs: database connections, and how long to wait to connect and for a query's answer.
JOB_DB_POOL_SIZE=2
JOB_DB_CONNECT_TIMEOUT_MS=30000
JOB_DB_QUERY_TIMEOUT_MS=300000
# Update job: stops after this many assets fail in a row, or once more than this share has failed.
JOB_MAX_CONSECUTIVE_FAILURES=5
JOB_MAX_FAILED_SHARE=0.1
# Universe job: changes nothing if fewer than this share of active assets would remain.
UNIVERSE_MIN_REMAINING_SHARE=0.8
# Update job: a change this large in a key figure is noted in the run summary. 0.5 is 50%.
LARGE_SWING_SHARE=0.5
# Update job: how long a value stays after the provider stops reporting it.
MISSING_GRACE_DAYS=7
# Update job: history days sent to the database in one statement.
HISTORY_BATCH_SIZE=5000
# Jobs: the monitor ping's timeout and largest body. Healthchecks.io keeps the first 100 kB.
JOB_MONITOR_TIMEOUT_MS=10000
JOB_MONITOR_BODY_LIMIT=90000

# Providers: addresses and page sizes.
RWA_XYZ_BASE_URL=https://api.rwa.xyz/v4
RWA_XYZ_PAGE_SIZE=100
KAMINO_BASE_URL=https://api.kamino.finance
KAMINO_TOKEN_LIMIT=1000
# Providers: the pause between requests, each request's timeout, retries and the first retry's wait.
PROVIDER_REQUEST_INTERVAL_MS=250
PROVIDER_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=4
PROVIDER_BACKOFF_MS=1000
# Providers: a rate-limit wait longer than this ends the run as out of quota.
PROVIDER_MAX_RATE_LIMIT_WAIT_MS=120000
