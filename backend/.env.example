# Copy to .env and fill in. The backend won't start until both are set.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Railway Storage Bucket, from the bucket's Credentials tab. Only needed by code that
# uses RailwayBucketStorage.fromEnv(). On Railway, these can reference the bucket's
# variables, e.g. S3_BUCKET=${{my-bucket.BUCKET}}.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
