# Only what the Dockerfile copies. The repository root also holds database dumps, backups and .env
# files, so everything else stays out of the build.
*
!backend/package.json
!backend/package-lock.json
!backend/.npmrc
!backend/src
!backend/scripts
!backend/db
!frontend/package.json
!frontend/package-lock.json
!frontend/.npmrc
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src
**/.env*
